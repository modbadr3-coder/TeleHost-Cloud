# VERCEL_TOKEN: Personal API Token for deploying websites directly to Vercel Global Edge Network (https://<project>.vercel.app)
# Generate at: https://vercel.com/account/tokens
# Configure this token in the Secrets panel in the AI Studio UI or inside the app Cloud Vault.
VERCEL_TOKEN=YOUR_VERCEL_API_TOKEN

# NETLIFY_TOKEN: Personal Access Token for deploying websites via ZIP bundle to Netlify Global CDN (https://<project>.netlify.app)
# Generate at: https://app.netlify.com/user/applications#personal-access-tokens
# Configure this token in the Secrets panel in the AI Studio UI or inside the app Cloud Vault.
NETLIFY_TOKEN=YOUR_NETLIFY_PERSONAL_ACCESS_TOKEN

# GITHUB_PAT: Personal Access Token for deploying static websites directly to GitHub Pages (https://<username>.github.io/<repo>/)
# Configure this token in the Secrets panel in the AI Studio UI if you want to use GitHub Pages deployment.
GITHUB_PAT=YOUR_GITHUB_PERSONAL_ACCESS_TOKEN
